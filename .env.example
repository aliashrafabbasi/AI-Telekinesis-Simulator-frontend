# =============================================================================
# Gotham Telekinesis — Frontend env (copy to .env)
# =============================================================================
# Keep only ONE block active. Restart the dev server after any change.
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION A — PRODUCTION / DEPLOY (Netlify)
# browser = user's webcam + MediaPipe in the browser
# -----------------------------------------------------------------------------
VITE_API_URL=https://YOUR_USERNAME-gotham-telekinesis-api.hf.space
VITE_TRACKING_MODE=browser

# -----------------------------------------------------------------------------
# OPTION B — LOCAL TESTING (Docker + server camera)
# server = backend WebSocket + Docker webcam
# -----------------------------------------------------------------------------
# VITE_API_URL=http://127.0.0.1:7860
# VITE_TRACKING_MODE=server
# VITE_WS_URL=ws://127.0.0.1:7860/ws
# VITE_PREVIEW_WS_URL=ws://127.0.0.1:7860/ws/preview

# -----------------------------------------------------------------------------
# Netlify deploy — set these in Site settings → Build & deploy → Environment
# -----------------------------------------------------------------------------
# VITE_API_URL=https://YOUR_USERNAME-gotham-telekinesis-api.hf.space
# VITE_TRACKING_MODE=browser
# (Do not set WS URLs — not needed in browser mode)
